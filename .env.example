# 数据库（本仓库不含真实凭据，请填入你自己的 MySQL 实例）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_workbench

# opencode Agent 运行时（本机进程间调用，无需对外）
OPENCODE_BASE=http://127.0.0.1:4096
GATEWAY_PORT=8787
GATEWAY_HOST=127.0.0.1

# LLM（OpenAI 兼容接口；SenseNova 仅为示例，可换成任意兼容服务）
LLM_BASE=https://token.sensenova.cn/v1
LLM_KEY=YOUR_LLM_KEY
LLM_MODEL=sensenova-6.8-flash-lite
